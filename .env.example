PORT=5000
JWT_SECRET=diu_nexus_super_secret_jwt_key_2025_change_in_production
NODE_ENV=development

# 🗄️ DATABASE CONFIGURATION - Supports 3 modes (auto-fallback)
# 1. MongoDB Atlas (Cloud) - Recommended for production with many users
#    Get free cluster at https://cloud.mongodb.com
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/diunexus?retryWrites=true&w=majority
# MONGO_DB_NAME=diunexus

# 2. PostgreSQL Cloud (Supabase / Neon / Render / Railway)
#    Paste your Cloud PostgreSQL connection string below:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 3. Local SQLite (Default - No config needed!)
#    If no cloud DB is set, DIU Nexus automatically uses the built-in local SQLite database!
#    File: ./database.sqlite (WAL mode, auto-created, never exposed via HTTP)

# 🤖 Nexus AI — Local DIU Brain (no external API needed)
# Reads real-time campus data (bus, housing, marketplace, blood, events) + C programming basics to advanced
# No API key needed — 100% local, fast, private

# 📧 Gmail OTP Authentication
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
